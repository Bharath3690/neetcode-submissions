class Solution {
    public int maxDepth(String s) {
        int currdepth = 0,maxdepth = 0;
        for(char c:s.toCharArray()){
            if(c=='('){
                currdepth++;
                maxdepth = Math.max(maxdepth,currdepth);
            }else if(c==')'){
                currdepth--;
            }
        }
        return maxdepth;
    }
}
