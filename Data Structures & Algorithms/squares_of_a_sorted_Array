class Solution {
    public int[] sortedSquares(int[] nums) {
        int l  = 0;
        int r = nums.length-1;
        int k = nums.length-1;
        int ans[] = new int[nums.length];
        while(l<=r){
            int lftsqr = nums[l]*nums[l];
            int rghsqr = nums[r]*nums[r];
            if(lftsqr>rghsqr){
                ans[k] = lftsqr;
                l++;
            }else {
                ans[k] = rghsqr;
                r--;
            }
            k--;
        }
        return ans;
    }
}
